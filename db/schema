-- Loan Application System: MySQL schema
CREATE DATABASE IF NOT EXISTS loan_db;
USE loan_db;

CREATE TABLE IF NOT EXISTS users (
    id               INT AUTO_INCREMENT PRIMARY KEY,
    fname            VARCHAR(50)  NOT NULL,
    lname            VARCHAR(50)  NOT NULL,
    mobile           VARCHAR(10)  NOT NULL,
    email            VARCHAR(100) NOT NULL UNIQUE,
    location         VARCHAR(100) NOT NULL,
    lastmodifieddate TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status           VARCHAR(10)  NOT NULL DEFAULT 'Active',
    username         VARCHAR(30)  NOT NULL UNIQUE,
    password         VARCHAR(200) NOT NULL,          -- salted SHA-256, never plain text
    user_role        VARCHAR(15)  NOT NULL DEFAULT 'ROLE_USER',
    failed_attempts  INT          NOT NULL DEFAULT 0,
    pan_card         VARCHAR(10)  NULL,
    cibil_score      INT          NULL
);

CREATE TABLE IF NOT EXISTS loans (
    loan_id          INT AUTO_INCREMENT PRIMARY KEY,
    user_id          INT           NOT NULL,
    loan_amount      DECIMAL(15,2) NOT NULL,
    loan_type        VARCHAR(30)   NOT NULL,
    loan_duration    INT           NOT NULL,           -- months
    interest_rate    DECIMAL(5,2)  NOT NULL,           -- % per annum
    annual_income    DECIMAL(15,2) NOT NULL,
    purpose          VARCHAR(255)  NOT NULL,
    status           VARCHAR(20)   NOT NULL DEFAULT 'Pending',
    application_date TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    remarks          VARCHAR(500)  NULL,               -- rejection reason / info requested
    emi_amount       DECIMAL(15,2) NULL,
    total_interest   DECIMAL(15,2) NULL,
    total_payable    DECIMAL(15,2) NULL,
    CONSTRAINT fk_loans_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS audit_log (
    id              INT AUTO_INCREMENT PRIMARY KEY,
    action          VARCHAR(30)  NOT NULL,
    performed_by    VARCHAR(30)  NOT NULL,
    target_user_id  INT          NULL,
    target_username VARCHAR(30)  NULL,
    details         VARCHAR(500) NULL,
    created_at      TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP
);

