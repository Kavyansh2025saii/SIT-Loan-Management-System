package com.sit.loan.dao;

import com.sit.loan.model.User;
import com.sit.loan.util.DBConnection;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class UserDao {

    private static User map(ResultSet rs) throws SQLException {
        User u = new User();
        u.id = rs.getInt("id");
        u.fname = rs.getString("fname");
        u.lname = rs.getString("lname");
        u.mobile = rs.getString("mobile");
        u.email = rs.getString("email");
        u.location = rs.getString("location");
        u.lastModifiedDate = rs.getTimestamp("lastmodifieddate");
        u.status = rs.getString("status");
        u.username = rs.getString("username");
        u.password = rs.getString("password");
        u.role = rs.getString("user_role");
        u.failedAttempts = rs.getInt("failed_attempts");
        u.panCard = rs.getString("pan_card");
        int cibil = rs.getInt("cibil_score");
        u.cibilScore = rs.wasNull() ? null : cibil;
        return u;
    }

    public int insert(User u) throws SQLException {
        String sql = "INSERT INTO users (fname, lname, mobile, email, location, lastmodifieddate, status, "
                + "username, password, user_role, failed_attempts, pan_card, cibil_score) "
                + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)";
        try (Connection c = DBConnection.get();
             PreparedStatement ps = c.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {
            ps.setString(1, u.fname);
            ps.setString(2, u.lname);
            ps.setString(3, u.mobile);
            ps.setString(4, u.email);
            ps.setString(5, u.location);
            ps.setTimestamp(6, new Timestamp(System.currentTimeMillis()));
            ps.setString(7, User.ACTIVE);
            ps.setString(8, u.username);
            ps.setString(9, u.password);
            ps.setString(10, u.role);
            ps.setInt(11, 0);
            ps.setString(12, u.panCard);
            if (u.cibilScore == null) ps.setNull(13, Types.INTEGER); else ps.setInt(13, u.cibilScore);
            ps.executeUpdate();
            try (ResultSet keys = ps.getGeneratedKeys()) {
                if (keys.next()) { u.id = keys.getInt(1); }
            }
            return u.id;
        }
    }

    private User one(String sql, String... params) throws SQLException {
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement(sql)) {
            for (int i = 0; i < params.length; i++) ps.setString(i + 1, params[i]);
            try (ResultSet rs = ps.executeQuery()) {
                return rs.next() ? map(rs) : null;
            }
        }
    }

    public User findById(int id) throws SQLException {
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement("SELECT * FROM users WHERE id=?")) {
            ps.setInt(1, id);
            try (ResultSet rs = ps.executeQuery()) { return rs.next() ? map(rs) : null; }
        }
    }

    /** Login / reset lookup: the identifier may be a username or an email. */
    public User findByUsernameOrEmail(String identifier) throws SQLException {
        return one("SELECT * FROM users WHERE username=? OR email=? LIMIT 1", identifier, identifier);
    }

    public boolean usernameExists(String username) throws SQLException {
        return one("SELECT * FROM users WHERE username=?", username) != null;
    }

    public boolean emailExists(String email, int excludeId) throws SQLException {
        try (Connection c = DBConnection.get();
             PreparedStatement ps = c.prepareStatement("SELECT 1 FROM users WHERE email=? AND id<>?")) {
            ps.setString(1, email);
            ps.setInt(2, excludeId);
            try (ResultSet rs = ps.executeQuery()) { return rs.next(); }
        }
    }

    /** field must be one of the whitelisted column names below. */
    public List<User> search(String field, String value) throws SQLException {
        String col;
        boolean exact = false;
        switch (field) {
            case "fname": col = "fname"; break;
            case "lname": col = "lname"; break;
            case "email": col = "email"; break;
            case "mobile": col = "mobile"; break;
            case "username": col = "username"; break;
            case "status": col = "status"; exact = true; break;
            default: throw new IllegalArgumentException("Unknown search field");
        }
        String sql = "SELECT * FROM users WHERE " + col + (exact ? " = ?" : " LIKE ?") + " ORDER BY id";
        List<User> list = new ArrayList<>();
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement(sql)) {
            ps.setString(1, exact ? value : "%" + value + "%");
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) list.add(map(rs));
            }
        }
        return list;
    }

    public void updateDetails(User u) throws SQLException {
        String sql = "UPDATE users SET fname=?, lname=?, mobile=?, email=?, location=?, lastmodifieddate=? WHERE id=?";
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement(sql)) {
            ps.setString(1, u.fname);
            ps.setString(2, u.lname);
            ps.setString(3, u.mobile);
            ps.setString(4, u.email);
            ps.setString(5, u.location);
            ps.setTimestamp(6, new Timestamp(System.currentTimeMillis()));
            ps.setInt(7, u.id);
            ps.executeUpdate();
        }
    }

    /** Activating also clears failed attempts so an unlocked user gets a fresh start. */
    public void updateStatus(int id, String status) throws SQLException {
        String sql = "UPDATE users SET status=?, failed_attempts=CASE WHEN ?='Active' THEN 0 ELSE failed_attempts END, "
                + "lastmodifieddate=? WHERE id=?";
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement(sql)) {
            ps.setString(1, status);
            ps.setString(2, status);
            ps.setTimestamp(3, new Timestamp(System.currentTimeMillis()));
            ps.setInt(4, id);
            ps.executeUpdate();
        }
    }

    public void updatePassword(int id, String hash) throws SQLException {
        try (Connection c = DBConnection.get();
             PreparedStatement ps = c.prepareStatement("UPDATE users SET password=?, lastmodifieddate=? WHERE id=?")) {
            ps.setString(1, hash);
            ps.setTimestamp(2, new Timestamp(System.currentTimeMillis()));
            ps.setInt(3, id);
            ps.executeUpdate();
        }
    }

    public void setFailedAttempts(int id, int count) throws SQLException {
        try (Connection c = DBConnection.get();
             PreparedStatement ps = c.prepareStatement("UPDATE users SET failed_attempts=? WHERE id=?")) {
            ps.setInt(1, count);
            ps.setInt(2, id);
            ps.executeUpdate();
        }
    }

    public void updatePanAndCibil(int id, String pan, int score) throws SQLException {
        try (Connection c = DBConnection.get();
             PreparedStatement ps = c.prepareStatement("UPDATE users SET pan_card=?, cibil_score=?, lastmodifieddate=? WHERE id=?")) {
            ps.setString(1, pan);
            ps.setInt(2, score);
            ps.setTimestamp(3, new Timestamp(System.currentTimeMillis()));
            ps.setInt(4, id);
            ps.executeUpdate();
        }
    }

    /** Loans are removed by the ON DELETE CASCADE foreign key. */
    public void delete(int id) throws SQLException {
        try (Connection c = DBConnection.get(); PreparedStatement ps = c.prepareStatement("DELETE FROM users WHERE id=?")) {
            ps.setInt(1, id);
            ps.executeUpdate();
        }
    }
}
