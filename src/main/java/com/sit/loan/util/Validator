package com.sit.loan.util;

import java.util.regex.Pattern;

public final class Validator {
    private static final Pattern EMAIL = Pattern.compile("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$");
    private static final Pattern MOBILE = Pattern.compile("^\\d{10}$");
    private static final Pattern PAN = Pattern.compile("^[A-Z]{5}[0-9]{4}[A-Z]$");
    private static final Pattern NAME = Pattern.compile("^[A-Za-z]+$");
    // 8+ chars, one upper, one lower, one digit, one special
    private static final Pattern PASSWORD =
            Pattern.compile("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{8,}$");
    private static final Pattern USERNAME = Pattern.compile("^[A-Za-z0-9_.-]{3,30}$");

    public static final String PASSWORD_RULE =
            "Password must be at least 8 characters with one uppercase, one lowercase, one digit and one special character.";

    private Validator() {}

    public static boolean isEmail(String s) { return s != null && EMAIL.matcher(s).matches(); }
    public static boolean isMobile(String s) { return s != null && MOBILE.matcher(s).matches(); }
    public static boolean isPan(String s) { return s != null && PAN.matcher(s).matches(); }
    public static boolean isName(String s) { return s != null && NAME.matcher(s).matches(); }
    public static boolean isStrongPassword(String s) { return s != null && PASSWORD.matcher(s).matches(); }
    public static boolean isUsername(String s) { return s != null && USERNAME.matcher(s).matches(); }
}
